# Ejemplo de .ENV

COOKIE_NAME=session_control_practicas
COOKIE_KEY=clave_secreta_cambiar
COOKIE_LIFETIME=3600
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict

HOST_DB=127.0.0.1;port=3308
USER_DB=root
PASSWORD_DB=
DATABASE=control_practicas_db
CHARSET=utf8mb4


# ALMACENAMIENTO DE ARCHIVOS (ver docs/SUBIDA_ARCHIVOS.md)
# local = carpeta del computador | s3 = bucket de Amazon S3 (o compatible)
STORAGE_DRIVER=local

# URL base con la que se descargan los archivos. Es el "link" que se guarda en la BD
# como prefijo de cada archivo. local: URL de la carpeta servida por Apache.
# s3: https://<bucket>.s3.<region>.amazonaws.com o tu dominio de CloudFront.
STORAGE_PUBLIC_URL=http://localhost/SistemaControlPracticas/uploads

# Solo STORAGE_DRIVER=local. Carpeta física; si se omite usa <proyecto>/uploads
STORAGE_LOCAL_PATH=C:/xampp/htdocs/SistemaControlPracticas/uploads

# Solo STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
# Opcional: endpoint de un servicio compatible (MinIO, R2...). Vacío = AWS
STORAGE_S3_ENDPOINT=

# Opcional: prefijos de almacenamientos anteriores cuyas URLs siguen siendo válidas
# en la BD (separados por coma). Ej. al pasar a S3, la URL local anterior.
STORAGE_ALLOWED_URLS=

# Peso máximo por archivo en MB (debe ser <= upload_max_filesize de php.ini)
UPLOAD_MAX_MB=5
